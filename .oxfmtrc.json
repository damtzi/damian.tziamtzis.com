{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"ignorePatterns": [
		".agents/",
		"pnpm-lock.yaml",
		"node_modules/",
		"*.log",
		".env",
		".env.*",
		".DS_Store",
		".idea/",
		".wrangler/"
	]
}
