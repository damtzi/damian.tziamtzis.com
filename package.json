{
	"name": "tziamtzis-card",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --message \"$(git log -1 --pretty=%s)\"",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"prepare": "husky",
		"lint": "pnpm format:check",
		"lint-staged": "lint-staged"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/types": "^21.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"oxfmt": "^0.79.0",
		"wrangler": "^4.166.0"
	},
	"lint-staged": {
		"*.{html,ts,json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
	}
}
